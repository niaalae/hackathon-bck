enum TripStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELED
}

enum CollaboratorRole {
  OWNER
  EDITOR
  VIEWER
}

enum BookingType {
  FLIGHT
  STAY
  EXPERIENCE
  RENTAL
  GUIDE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum SwipeDirection {
  LIKE
  PASS
}

enum MatchStatus {
  ACTIVE
  BLOCKED
}

model Trip {
  id          String     @id @default(uuid())
  ownerUserId String     @map("owner_user_id")
  title       String
  description String?
  cityId      String?    @map("city_id")
  status      TripStatus @default(DRAFT)
  startDate   DateTime?  @map("start_date")
  endDate     DateTime?  @map("end_date")
  budgetTotal Decimal?   @map("budget_total") @db.Decimal(12, 2)
  currency    String?    @default("USD")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner         User                 @relation("TripOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  city          City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  collaborators TripCollaborator[]
  items         TripItem[]
  bookings      Booking[]
  ratings       Rating[]
  messages      Message[]

  @@index([ownerUserId])
  @@index([cityId])
  @@map("trips")
}

model TripCollaborator {
  tripId   String           @map("trip_id")
  userId   String           @map("user_id")
  role     CollaboratorRole @default(VIEWER)
  joinedAt DateTime         @default(now()) @map("joined_at")

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
  @@map("trip_collaborators")
}

model TripItem {
  id       String   @id @default(uuid())
  tripId   String   @map("trip_id")
  day      Int?
  title    String
  location String?
  time     DateTime?
  notes    String?
  type     String?

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_items")
}

model Booking {
  id              String        @id @default(uuid())
  tripId          String?       @map("trip_id")
  userId          String        @map("user_id")
  itemName        String        @default("Untitled Booking") @map("item_name")
  type            BookingType
  provider        String?
  externalRef     String?       @map("external_ref")
  basePrice       Decimal       @default(0) @db.Decimal(12, 2) @map("base_price")
  commissionPct   Decimal       @default(0.10) @db.Decimal(5, 2) @map("commission_pct")
  commissionValue Decimal       @default(0) @db.Decimal(12, 2) @map("commission_value")
  currency        String?       @default("USD")
  status          BookingStatus @default(PENDING)
  startDate       DateTime?     @map("start_date")
  endDate         DateTime?     @map("end_date")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at")

  trip            Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
  @@map("bookings")
}

model Rating {
  id         String   @id @default(uuid())
  fromUserId String   @map("from_user_id")
  guideId    String   @map("guide_id")
  tripId     String?  @map("trip_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser User  @relation("RatingFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  guide    Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  trip     Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([guideId])
  @@index([fromUserId])
  @@map("ratings")
}

model Message {
  id         String   @id @default(uuid())
  fromUserId String   @map("from_user_id")
  toGuideId  String   @map("to_guide_id")
  tripId     String?  @map("trip_id")
  message    String
  status     String?
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser User  @relation("MessageFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toGuide  Guide @relation("MessageToGuide", fields: [toGuideId], references: [id], onDelete: Cascade)
  trip     Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([toGuideId])
  @@map("messages")
}

model Swipe {
  id            String         @id @default(uuid())
  fromUserId    String         @map("from_user_id")
  targetUserId  String?        @map("target_user_id")
  targetGuideId String?        @map("target_guide_id")
  direction     SwipeDirection
  createdAt     DateTime       @default(now()) @map("created_at")

  fromUser    User   @relation("SwipeFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  targetGuide Guide? @relation("SwipeToGuide", fields: [targetGuideId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@map("swipes")
}

model Match {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  targetUserId String?     @map("target_user_id")
  guideId      String?     @map("guide_id")
  status       MatchStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at")

  user  User   @relation("MatchUser", fields: [userId], references: [id], onDelete: Cascade)
  guide Guide? @relation("MatchGuide", fields: [guideId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("matches")
}
