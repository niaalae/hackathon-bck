enum UserRole {
  TRAVELER
  GUIDE
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         UserRole @default(TRAVELER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences  Json?

  guideProfile Guide?
  tripsOwned   Trip[]   @relation("TripOwner")
  collabs      TripCollaborator[]
  bookings     Booking[]
  ratingsGiven Rating[]  @relation("RatingFromUser")
  messagesSent Message[] @relation("MessageFromUser")
  swipes       Swipe[]   @relation("SwipeFromUser")
  matches      Match[]   @relation("MatchUser")
  groupMemberships GroupMembership[]
  groupMessages    GroupMessage[]
}

model Guide {
  id             String   @id @default(uuid())
  userId         String   @unique
  headline       String?
  bio            String?
  rateHourly     Decimal? @db.Decimal(10, 2)
  rateDaily      Decimal? @db.Decimal(10, 2)
  locationCityId String?
  contactEmail   String?
  contactPhone   String?
  verified       Boolean  @default(false)
  ratingAvg      Decimal? @db.Decimal(3, 2)
  ratingCount    Int      @default(0)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationCity City?     @relation("CityGuides", fields: [locationCityId], references: [id])
  media        GuideMedia[]
  pastTrips    GuidePastTrip[]
  ratings      Rating[]
  messages     Message[] @relation("MessageToGuide")
  swipesTarget Swipe[]   @relation("SwipeToGuide")
  matches      Match[]   @relation("MatchGuide")
}

model GuideMedia {
  id       String   @id @default(uuid())
  guideId  String
  type     MediaType
  url      String
  caption  String?
  position Int      @default(0)

  guide    Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
}

model GuidePastTrip {
  id        String    @id @default(uuid())
  guideId   String
  title     String
  location  String
  startDate DateTime?
  endDate   DateTime?
  summary   String?
  mediaUrl  String?

  guide     Guide     @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId])
}
