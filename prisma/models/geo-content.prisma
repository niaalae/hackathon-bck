enum MediaType {
  PHOTO
  VIDEO
}

enum InfoScope {
  REGION
  CITY
  ATTRACTION
}

model Region {
  id          String   @id @default(uuid())
  name        String
  country     String
  slug        String   @unique
  description String?
  coverImage  String?

  cities     City[]
  infoBlocks InfoBlock[] @relation("RegionInfo")
}

model City {
  id          String   @id @default(uuid())
  regionId    String
  name        String
  slug        String   @unique
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  timezone    String?
  description String?
  coverImage  String?

  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  attractions Attraction[]
  guides      Guide[]  @relation("CityGuides")
  trips       Trip[]
  groups      Group[]
  infoBlocks  InfoBlock[] @relation("CityInfo")

  @@index([regionId])
}

model Group {
  id        String   @id @default(uuid())
  cityId    String
  startDate DateTime
  endDate   DateTime
  capacity  Int
  budgetMin Decimal  @db.Decimal(12, 2)
  budgetMax Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  memberships GroupMembership[]
  messages    GroupMessage[]

  @@index([cityId])
  @@index([startDate])
  @@index([endDate])
}

enum GroupMembershipStatus {
  PENDING
  MEMBER
}

model GroupMembership {
  groupId     String
  userId      String
  status      GroupMembershipStatus @default(PENDING)
  requestedAt DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt

  group       Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@index([status])
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([userId])
}

model Attraction {
  id              String   @id @default(uuid())
  cityId          String
  name            String
  slug            String   @unique
  type            String?
  lat             Decimal? @db.Decimal(9, 6)
  lng             Decimal? @db.Decimal(9, 6)
  description     String?
  avgPrice        Decimal? @db.Decimal(10, 2)
  durationMinutes Int?
  coverImage      String?

  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  media      AttractionMedia[]
  tags       AttractionTagMap[]
  infoBlocks InfoBlock[] @relation("AttractionInfo")

  @@index([cityId])
}

model AttractionMedia {
  id           String   @id @default(uuid())
  attractionId String
  type         MediaType
  url          String
  caption      String?
  position     Int      @default(0)

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
}

model Tag {
  id   String @id @default(uuid())
  name String @unique

  attractions AttractionTagMap[]
}

model AttractionTagMap {
  attractionId String
  tagId        String

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([attractionId, tagId])
}

model InfoBlock {
  id           String    @id @default(uuid())
  scope        InfoScope
  regionId     String?
  cityId       String?
  attractionId String?
  title        String
  content      String
  category     String?
  language     String?   @default("en")

  region     Region?     @relation("RegionInfo", fields: [regionId], references: [id], onDelete: Cascade)
  city       City?       @relation("CityInfo", fields: [cityId], references: [id], onDelete: Cascade)
  attraction Attraction? @relation("AttractionInfo", fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([regionId])
  @@index([cityId])
  @@index([attractionId])
}

model Translation {
  id         String @id @default(uuid())
  entityType String
  entityId   String
  language   String
  field      String
  value      String

  @@index([entityType, entityId])
}
